{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "berryboy-venue-manifest.v1.schema.json",
  "title": "Berryboy Venue Manifest v1",
  "type": "object",
  "required": ["schema", "venueId", "versionId", "assets", "spawnPoints"],
  "properties": {
    "schema": { "const": "berryboy-venue-manifest.v1" },
    "venueId": { "type": "string", "minLength": 1 },
    "versionId": { "type": "string", "minLength": 1 },
    "coordinateSystem": {
      "type": "object",
      "properties": {
        "upAxis": { "enum": ["Y"] },
        "units": { "enum": ["meters"] }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assetId", "role"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "role": { "enum": ["walls", "floor", "ceiling", "props", "building", "collision", "navigation", "decorations"] },
          "publicUrl": { "type": "string" },
          "path": { "type": "string" },
          "enabled": { "type": "boolean" },
          "critical": { "type": "boolean" },
          "loadOrder": { "type": "number" },
          "deferUntilInteractionGate": { "type": "boolean" },
          "meshRules": { "type": "object" },
          "shadowPolicy": { "type": "object" },
          "collisionPolicy": { "type": "object" },
          "streamingPolicy": { "type": "object" },
          "materialPolicy": { "type": "object" },
          "metadata": { "type": "object" }
        },
        "anyOf": [
          { "required": ["publicUrl"] },
          { "required": ["path"] }
        ]
      }
    },
    "spawnPoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "position", "target"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "position": { "$ref": "#/$defs/vector3" },
          "target": { "$ref": "#/$defs/vector3" },
          "safe": { "type": "boolean" },
          "visitor": { "type": "boolean" }
        }
      }
    },
    "zones": { "type": "array" },
    "zoneAdjacency": { "type": "array" },
    "collisionSets": { "type": "array" },
    "walkableAreas": { "type": "array" },
    "artworkAnchors": { "type": "array" },
    "sculptureAnchors": { "type": "array" },
    "navigationGraph": { "type": "object" },
    "editableMaterials": { "type": "array" },
    "lockedMaterials": { "type": "array" },
    "meshRules": { "type": "object" },
    "lightingDefaults": { "type": "object" },
    "mobileBudgets": { "type": "object" },
    "technicalFlags": { "type": "object" }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    }
  }
}
